{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/retailbox-automation/x402-work-receipts/docs/schemas/payment.v1.schema.json",
  "title": "receipt.v1 + payment.v1 (x402-work-receipts profile)",
  "$comment": "GENERATED by build_payment_profile.py from receipt.v1.schema.json (source: RetailBox A2A Bridge, spec 2026-09-04 §3.2). The base forbids money fields by design; this profile adds `payment` and is the only schema in this repo that accepts it. Amounts are in tinybars (1 HBAR = 100 000 000).",
  "allOf": [
    {
      "$ref": "#/$defs/receipt_core"
    },
    {
      "type": "object",
      "required": [
        "payment"
      ],
      "properties": {
        "payment": {
          "type": "object",
          "description": "x402 payments this receipt accounts for: `intake` settled on acceptance, `balance` on delivery.",
          "properties": {
            "network": {
              "type": "string",
              "enum": [
                "hedera:testnet",
                "hedera:mainnet"
              ]
            },
            "asset": {
              "type": "string",
              "pattern": "^0\\.0\\.[0-9]+$",
              "description": "`0.0.0` = HBAR, otherwise an HTS token id"
            },
            "facilitator": {
              "type": "string",
              "format": "uri"
            },
            "payer": {
              "type": "string",
              "pattern": "^0\\.0\\.[0-9]+$"
            },
            "payee": {
              "type": "string",
              "pattern": "^0\\.0\\.[0-9]+$"
            },
            "intake": {
              "$ref": "#/$defs/leg"
            },
            "balance": {
              "$ref": "#/$defs/leg"
            }
          },
          "required": [
            "network",
            "asset",
            "facilitator",
            "payer",
            "payee",
            "intake"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "receipt_core": {
      "title": "receipt.v1",
      "description": "Квитанция исполнителя заказчику. `kind=accepted` — сразу при приёме наряда; `kind=delivered` — по готовности, со ссылками на результат; `kind=rejected` — формальный отказ приёмника: присланное не является наряд-форматом этой пары либо невалидно. Ссылается на заякоренный ВХОД: `mandate_envelope_hash` = sha256 канонизации (RFC 8785) конверта наряда как подписан (шифротекст + подпись), то есть поле `eh` записи `apmsg dir:'in'`.",
      "$comment": "Источник и норматив: Retailbox A2A Bridge, docs/superpowers/specs/2026-09-04-a2a-pilot-mandate-receipt-design.md §3.2. Что доказывает цепочка — §4.2 там же: «запечатанный наряд с этим отпечатком существовал не позже консенсусной отметки и был принят подписью второй стороны»; содержимое, качество и факт исполнения НЕ доказываются. Денежных/часовых полей нет по решению 04.09; расширение payment (публичный профиль x402-work-receipts) — отдельной схемой через allOf, Bridge-пилот его не принимает. kind=rejected добавлен 07.09.2026: формальный отказ получателя на формат/невалидный наряд, замыкает цикл без людей; копия схемы в публичном репо x402-work-receipts обновляется отдельно с провенансом.",
      "type": "object",
      "required": [
        "receipt_id",
        "kind",
        "mandate_id",
        "mandate_envelope_hash",
        "mandate_anchor",
        "taken",
        "issued_at",
        "issuer"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "uuid7"
        },
        "kind": {
          "enum": [
            "accepted",
            "delivered",
            "rejected"
          ]
        },
        "mandate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "из наряда; для kind=rejected — msg_id отвергнутого сообщения"
        },
        "mandate_envelope_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 hex канонизированного конверта наряда как подписан (= eh записи apmsg dir:'in'); для kind=rejected — отвергнутого сообщения"
        },
        "mandate_anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topic",
            "seq",
            "consensus_ts"
          ],
          "properties": {
            "topic": {
              "type": "string",
              "pattern": "^0\\.0\\.[0-9]+$",
              "description": "HCS-топик, где лежит запись входа"
            },
            "seq": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "sequence number; null, пока mirror не догнал"
            },
            "consensus_ts": {
              "type": [
                "string",
                "null"
              ],
              "description": "консенсусная отметка времени (строка mirror `seconds.nanos` или ISO-8601); null, пока mirror не догнал"
            }
          },
          "description": "где лежит запись входа; для kind=rejected — запись отвергнутого сообщения"
        },
        "taken": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": "что принято к исполнению (критерии, которые исполнитель подтверждает)"
        },
        "declined": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "reason"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          "description": "что не берём и почему"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pr_url",
            "staging_url",
            "notion_status"
          ],
          "properties": {
            "pr_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "staging_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "notion_status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "статус стори у заказчика после сдачи (например «Тестирование»)"
            }
          },
          "description": "обязателен при kind=delivered"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "только при kind=rejected: почему присланное не принято (человекочитаемо, без содержимого наряда)"
        },
        "expected_schema": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
          "description": "только при kind=rejected: тег формата, который приёмник принимает (mandate.v1)"
        },
        "schema_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048,
          "description": "только при kind=rejected: где лежит норматив ожидаемого формата"
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "только при kind=rejected: чем отправить наряд правильно (инструмент/команда)"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "issuer": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,31}$",
          "description": "handle исполнителя"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "delivered"
              }
            }
          },
          "then": {
            "required": [
              "result"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "taken": {
                "minItems": 1
              },
              "result": false
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "required": [
              "reason",
              "expected_schema",
              "schema_url"
            ],
            "properties": {
              "taken": {
                "maxItems": 0
              },
              "result": false
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "accepted",
                  "delivered"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": false,
              "expected_schema": false,
              "schema_url": false,
              "hint": false
            }
          }
        }
      ]
    },
    "leg": {
      "type": "object",
      "properties": {
        "tinybars": {
          "type": "integer",
          "minimum": 1
        },
        "transaction_id": {
          "type": "string",
          "pattern": "^0\\.0\\.[0-9]+@[0-9]+\\.[0-9]+$",
          "description": "Hedera transaction id as returned by the facilitator, e.g. 0.0.7162784@1788539653.433840739"
        },
        "consensus_timestamp": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topic"
          ],
          "properties": {
            "topic": {
              "type": "string",
              "pattern": "^0\\.0\\.[0-9]+$"
            },
            "seq": {
              "type": [
                "integer",
                "null"
              ]
            },
            "consensus_ts": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "required": [
        "tinybars",
        "transaction_id"
      ],
      "additionalProperties": false
    }
  }
}
