{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/retailbox-automation/x402-work-receipts/docs/schemas/payment.v1.schema.json",
  "title": "receipt.v1 + payment.v1 (x402-work-receipts profile)",
  "$comment": "GENERATED by build_payment_profile.py from receipt.v1.schema.json. The base forbids money fields by design; this profile adds `payment` and is the only schema in this repo that accepts it. Amounts are in tinybars (1 HBAR = 100 000 000).",
  "allOf": [
    {
      "$ref": "#/$defs/receipt_core"
    },
    {
      "type": "object",
      "required": [
        "payment"
      ],
      "properties": {
        "payment": {
          "type": "object",
          "description": "x402 payments this receipt accounts for: `intake` settled on acceptance, `balance` on delivery.",
          "properties": {
            "network": {
              "type": "string",
              "enum": [
                "hedera:testnet",
                "hedera:mainnet"
              ]
            },
            "asset": {
              "type": "string",
              "pattern": "^0\\.0\\.[0-9]+$",
              "description": "`0.0.0` = HBAR, otherwise an HTS token id"
            },
            "facilitator": {
              "type": "string",
              "format": "uri"
            },
            "payer": {
              "type": "string",
              "pattern": "^0\\.0\\.[0-9]+$"
            },
            "payee": {
              "type": "string",
              "pattern": "^0\\.0\\.[0-9]+$"
            },
            "intake": {
              "$ref": "#/$defs/leg"
            },
            "balance": {
              "$ref": "#/$defs/leg"
            }
          },
          "required": [
            "network",
            "asset",
            "facilitator",
            "payer",
            "payee",
            "intake"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "receipt_core": {
      "title": "receipt.v1",
      "description": "Receipt from a contractor agent to a customer agent. `kind=accepted` — issued on intake of a mandate; `kind=delivered` — on completion, with links to the result; `kind=rejected` — a formal refusal: what arrived is not this pair's mandate format, or is not valid. It points at the recorded intake: `mandate_envelope_hash` is the sha256 of the canonical form (RFC 8785) of the mandate envelope as signed (ciphertext plus signature).",
      "type": "object",
      "required": [
        "receipt_id",
        "kind",
        "mandate_id",
        "mandate_envelope_hash",
        "mandate_anchor",
        "taken",
        "issued_at",
        "issuer"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "uuid7"
        },
        "kind": {
          "enum": [
            "accepted",
            "delivered",
            "rejected"
          ]
        },
        "mandate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "from the mandate; for `kind=rejected` — the message id of the refused message"
        },
        "mandate_envelope_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 hex of the canonical mandate envelope as signed; for `kind=rejected` — of the refused message"
        },
        "mandate_anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topic",
            "seq",
            "consensus_ts"
          ],
          "properties": {
            "topic": {
              "type": "string",
              "pattern": "^0\\.0\\.[0-9]+$",
              "description": "identifier of the append-only log that holds the intake record"
            },
            "seq": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "description": "sequence number of the record in the log; null until the record is readable"
            },
            "consensus_ts": {
              "type": [
                "string",
                "null"
              ],
              "description": "consensus timestamp of the record (`seconds.nanos` or ISO-8601); null until the record is readable"
            }
          },
          "description": "reference to the append-only log record of the intake; for `kind=rejected` — of the refused message"
        },
        "taken": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "description": "criteria the contractor takes on"
        },
        "declined": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "reason"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          "description": "criteria not taken, and why"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pr_url",
            "staging_url",
            "notion_status"
          ],
          "properties": {
            "pr_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "staging_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "notion_status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "story status at the customer after hand-off (for example \"Testing\")"
            }
          },
          "description": "required when `kind=delivered`"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "`kind=rejected` only: why the message was not accepted, human-readable and without quoting the mandate"
        },
        "expected_schema": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$",
          "description": "`kind=rejected` only: the format tag this receiver accepts (mandate.v1)"
        },
        "schema_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048,
          "description": "`kind=rejected` only: where the expected format is published"
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "`kind=rejected` only: how to send the mandate correctly (tool or command)"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "issuer": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,31}$",
          "description": "contractor handle"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "delivered"
              }
            }
          },
          "then": {
            "required": [
              "result"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "taken": {
                "minItems": 1
              },
              "result": false
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "required": [
              "reason",
              "expected_schema",
              "schema_url"
            ],
            "properties": {
              "taken": {
                "maxItems": 0
              },
              "result": false
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "accepted",
                  "delivered"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": false,
              "expected_schema": false,
              "schema_url": false,
              "hint": false
            }
          }
        }
      ]
    },
    "leg": {
      "type": "object",
      "properties": {
        "tinybars": {
          "type": "integer",
          "minimum": 1
        },
        "transaction_id": {
          "type": "string",
          "pattern": "^0\\.0\\.[0-9]+@[0-9]+\\.[0-9]+$",
          "description": "Hedera transaction id as returned by the facilitator, e.g. 0.0.7162784@1788539653.433840739"
        },
        "consensus_timestamp": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topic"
          ],
          "properties": {
            "topic": {
              "type": "string",
              "pattern": "^0\\.0\\.[0-9]+$"
            },
            "seq": {
              "type": [
                "integer",
                "null"
              ]
            },
            "consensus_ts": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "required": [
        "tinybars",
        "transaction_id"
      ],
      "additionalProperties": false
    }
  }
}
